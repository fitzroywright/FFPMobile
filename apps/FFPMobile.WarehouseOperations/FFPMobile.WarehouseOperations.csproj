<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>FFPMobile.App</RootNamespace>
    <ApplicationTitle>FFP Mobile Warehouse and Operations</ApplicationTitle>
    <ApplicationId>org.ffp.mobile.warehouse</ApplicationId>
    <AndroidManifest>Platforms/Android/AndroidManifest.xml</AndroidManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <AndroidPackageFormats>apk</AndroidPackageFormats>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
    <MauiIcon Include="Resources/AppIcon/appicon.svg" />
    <MauiSplashScreen Include="Resources/AppIcon/appicon.svg" Color="#075EBA" BaseSize="128,128" />
    <Compile Include="../../shared/Profiles/*.cs" Link="Shared/Profiles/%(Filename)%(Extension)" />
    <Compile Include="../../shared/WarehouseProtocol/*.cs" Link="Shared/WarehouseProtocol/%(Filename)%(Extension)" />
    <Compile Include="../../shared/Ui/AppColors.cs" Link="Shared/Ui/AppColors.cs" />
  </ItemGroup>
</Project>
