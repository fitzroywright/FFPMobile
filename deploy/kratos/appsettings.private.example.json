{
  "Security": {
    "ActiveDirectory": {
      "Domain": "FFTPJ.LOCAL",
      "SearchBase": "DC=FFTPJ,DC=LOCAL",
      "Servers": [ "replace-with-approved-dc.fftpj.local" ]
    }
  },
  "Devices": { "AdministratorAccountIds": [] },
  "FfpManager": {
    "PermissionServiceOrigin": "",
    "ServiceTokenSecret": "ffpmobile-xaf-service-token",
    "Bindings": {}
  },
  "CommonSecrets": {
    "Mode": "Production",
    "WorkloadName": "FFPMobile.Api",
    "EnvironmentName": "Production",
    "ProviderOrder": [ "PrimarySecrets" ],
    "Providers": {
      "PrimarySecrets": {
        "Type": "OpenBao",
        "Settings": {
          "Enabled": true,
          "Address": "https://replace-with-openbao-host:8200",
          "MountPath": "secret",
          "BasePath": "aegis/ffpmobile",
          "AuthMountPath": "approle",
          "RoleId": "",
          "SecretIdFile": "/etc/aegis/ffpmobile/openbao-secret-id",
          "RequireSecretIdFileInProduction": true,
          "DeleteSecretIdFileAfterRead": false,
          "RequireHttps": true,
          "RenewTokens": true,
          "RevokeTokenOnDispose": true
        }
      }
    }
  }
}
